{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch DataSense AI in Chrome",
      "type": "chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html"
    },
    {
      "name": "Launch DataSense AI (Local Server)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start Local HTTP Server"
    }
  ]
}
